{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "digit7s/filament-seo",
    "description": "SEO metadata, Static Pages, JSON-LD, and XML sitemap tools for Laravel and Filament.",
    "homepage": "https://github.com/Digit7s/filament-seo",
    "keywords": ["laravel", "filament", "seo", "metadata", "json-ld", "structured-data", "sitemap"],
    "license": "MIT",
    "type": "library",
    "support": {
        "issues": "https://github.com/Digit7s/filament-seo/issues",
        "source": "https://github.com/Digit7s/filament-seo"
    },
    "require": {
        "php": "^8.4",
        "ext-xmlwriter": "*",
        "filament/filament": "^5.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "Digit7s\\FilamentSeo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Digit7s\\FilamentSeo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Digit7s\\FilamentSeo\\FilamentSeoServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
